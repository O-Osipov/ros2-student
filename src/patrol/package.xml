<?xml version="1.0"?>
<package format="3">
  <name>patrol</name>
  <version>0.1.0</version>
  <description>PR03: Pose subscription, timer and cmd_vel remapping</description>
  <maintainer email="noreply@example.invalid">ROS course example</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend condition="$ROS_DISTRO == lyrical">turtlesim_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
