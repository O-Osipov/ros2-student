<?xml version="1.0"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.1.0</version>
  <description>PR05: namespaced turtlesim launch, QoS experiment and MCAP recording</description>
  <maintainer email="213808971+O-Osipov@users.noreply.github.com">O-Osipov</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend condition="$ROS_DISTRO == lyrical">turtlesim_msgs</exec_depend>
  <exec_depend>patrol</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
